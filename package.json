{
  "name": "gitwebui",
  "version": "0.1.0",
  "private": true,
  "description": "A local, GitKraken-style web git client",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "build:web": "npm run build --workspace web",
    "embed": "node scripts/embed-web.mjs",
    "build:exe:win": "bun build server/src/bunEntry.ts --compile --target=bun-windows-x64 --outfile release/gitwebui.exe",
    "build:exe:linux": "bun build server/src/bunEntry.ts --compile --target=bun-linux-x64 --outfile release/gitwebui",
    "build:exe": "npm run build:web && npm run embed && npm run build:exe:win && npm run build:exe:linux",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
